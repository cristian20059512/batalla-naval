<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.batallanaval.controller.MainController"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets top="16.0" right="16.0" bottom="8.0" left="16.0" />
            </padding>
            <Label text="Batalla Naval" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Label fx:id="statusLabel" text="Coloca tu flota" />
            <HBox alignment="CENTER" spacing="10.0">
                <Button text="Girar barco (R)" onAction="#onRotateShip" />
                <Button text="Colocar flota aleatoria" onAction="#onPlaceRandomFleet" />
                <Button text="Ver tablero enemigo" onAction="#onToggleVerification" />
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox alignment="CENTER" spacing="30.0">
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <VBox alignment="CENTER" spacing="6.0">
                <Label text="Tu tablero (posicion)" />
                <Pane fx:id="positionBoardContainer" />
            </VBox>
            <VBox alignment="CENTER" spacing="6.0">
                <Label text="Tablero enemigo (principal)" />
                <Pane fx:id="mainBoardContainer" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
