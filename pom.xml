<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.batallanaval</groupId>
    <artifactId>batalla-naval</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.3</javafx.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- formato modulo/clase porque el proyecto usa module-info.java -->
                    <mainClass>com.batallanaval/com.batallanaval.Main</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- corre las pruebas en classpath plano, ignorando module-info.java
                         (que solo aplica al codigo de produccion): evita los problemas
                         tipicos de JPMS con JUnit 5 (paquetes no abiertos, etc.) -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <!-- genera el Javadoc en HTML (mvn javadoc:javadoc) en
                     javadoc/, en la raiz del proyecto (no en target/, que
                     esta en .gitignore y desaparece con cada "mvn clean")
                     para que quede committeado y visible en el repo.
                     Doclint desactivado porque el proyecto no sigue
                     al pie de la letra todas las reglas estrictas de
                     formato de Javadoc (por ejemplo, HTML sin cerrar en
                     algunos comentarios), que harian fallar la generacion
                     sin aportar nada al contenido. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <doclint>none</doclint>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <doctitle>Batalla Naval - API Documentation</doctitle>
                    <reportOutputDirectory>${project.basedir}</reportOutputDirectory>
                    <destDir>javadoc</destDir>
                    <!-- module-info.java hace que javadoc entre en "modo
                         modulo" y, en ese modo, solo documenta lo que el
                         modulo exporta (com.batallanaval, el paquete de
                         Main) dejando afuera el resto (ai, controller,
                         model, persistence, util, view). Excluirlo del
                         set de archivos que procesa javadoc evita ese
                         modo y documenta todos los paquetes por igual. -->
                    <sourceFileExcludes>
                        <sourceFileExclude>module-info.java</sourceFileExclude>
                    </sourceFileExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
